# This is an example configuration file. To make it work, rename the file to 
# ".env" and fill in the parts marked <TODO>

# Configuration of the neuprint server
NEUPRINT_SERVER_URL=neuprint-cns.janelia.org
NEUPRINT_DATASET_NAME=male-cns:v1.0
#NEUPRINT_DATASET_NAME=flywire-fafb:v783b

# Set the source for meshes
SEGMENTATION_SOURCE='gs://flyem-male-cns/v1.0/segmentation'

# Set the source for rois
SHELL_SOURCE='gs://flyem-male-cns/rois/fullbrain-major-shells'

# Secret authentification token. You can find yours at 
# https://<NEUPRINT_SERVER_URL>/account, for example at
# https://neuprint-cns.janelia.org/account
NEUPRINT_APPLICATION_CREDENTIALS=<TODO>